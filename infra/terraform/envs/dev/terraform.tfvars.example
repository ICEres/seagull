aws_profile = ""
aws_region  = "ap-southeast-2"
project     = "seagull"
environment = "dev"

root_domain        = "gulls.ai"
message_api_domain = "fishing.gulls.ai"
web_domain_name    = "sea.gulls.ai"
landing_domain_name = "gulls.ai"
admin_domain_name  = "admin.gulls.ai"
mcp_domain_name    = "mcp.gulls.ai"

# Secret values are intentionally omitted from this example. Prefer GitHub
# Actions secrets or local environment-provided TF_VAR_* values.
# Set TF_VAR_message_hub_legacy_route_secret to a dedicated random credential
# of at least 32 characters when planning or applying this environment.
# Set ai_reply_provider and ai_reply_model together to enable hosted AI chat
# replies; leave both empty to keep that feature disabled.
# ai_reply_max_output_tokens defaults to 256 (valid range: 1-4096).

api_throttling_burst_limit    = 100
api_throttling_rate_limit     = 50
api_access_log_retention_days = 30

mcp_dev_owner_user_id        = "user_dev"
mcp_dev_agent_handles        = ["@runner:gulls.ai"]
mcp_no_auth_enabled          = false
mcp_no_auth_owner_user_id    = "user_chatgpt_dev"
mcp_no_auth_agent_handles    = []
mcp_no_auth_scopes           = ["agents:read"]
mcp_allowed_origins          = ["https://chatgpt.com", "https://chat.openai.com"]
mcp_cognito_domain_prefix    = ""
chatgpt_oauth_redirect_uris = [
  "https://chatgpt.com/connector_platform_oauth_redirect",
  "https://chatgpt.com/connector/oauth/b6YSyO7BohhS",
]
